{
  "name": "axi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @axi/api --filter @axi/dashboard dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present test",
    "clean": "pnpm -r --if-present clean",
    "live:tokens": "node scripts/dev/start-live-tokens.mjs",
    "live:tokens:metered": "node scripts/dev/start-live-tokens-metered.mjs",
    "live:tokens:stop": "pnpm local:stop",
    "live:tokens:logs": "pnpm local:logs",
    "setup:pumpportal-data-env": "node scripts/setup/create-pumpportal-data-env.mjs",
    "verify:pumpportal-data-env": "node scripts/setup/verify-pumpportal-data-env.mjs",
    "check:pumpportal-data-wallet": "node scripts/setup/check-pumpportal-data-wallet-balance.mjs",
    "smoke:pumpportal-metered-config": "node scripts/setup/smoke-pumpportal-metered-config.mjs",
    "local:stop": "node scripts/dev/stop-local.mjs",
    "local:restart": "node scripts/dev/restart-local.mjs",
    "local:logs": "node scripts/dev/show-local-logs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
