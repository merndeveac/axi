{
  "name": "axi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @axi/api --filter @axi/dashboard dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present test",
    "clean": "pnpm -r --if-present clean",
    "live:tokens": "pnpm axi:restart",
    "live:tokens:metered": "pnpm axi:restart:metered",
    "live:tokens:stop": "pnpm axi:stop",
    "live:tokens:logs": "pnpm axi:logs",
    "setup:pumpportal-data-env": "node scripts/setup/create-pumpportal-data-env.mjs",
    "verify:pumpportal-data-env": "node scripts/setup/verify-pumpportal-data-env.mjs",
    "check:pumpportal-data-wallet": "node scripts/setup/check-pumpportal-data-wallet-balance.mjs",
    "smoke:pumpportal-metered-config": "node scripts/setup/smoke-pumpportal-metered-config.mjs",
    "axi:doctor": "node scripts/dev/axi-doctor.mjs",
    "axi:clean": "node scripts/dev/axi-clean.mjs",
    "axi:rebuild": "node scripts/dev/axi-rebuild.mjs",
    "axi:launch": "node scripts/dev/axi-launch.mjs",
    "axi:restart": "node scripts/dev/axi-restart-clean.mjs",
    "axi:restart:metered": "node scripts/dev/axi-restart-clean.mjs --metered",
    "axi:stop": "node scripts/dev/axi-stop.mjs",
    "axi:logs": "node scripts/dev/axi-logs.mjs",
    "paper:automation:status": "pnpm --filter @axi/api paper:automation:status",
    "paper:forward:export": "pnpm --filter @axi/api paper:forward:export",
    "paper:forward:evaluate": "pnpm --filter @axi/api paper:forward:evaluate",
    "local:stop": "pnpm axi:stop",
    "local:restart": "pnpm axi:restart",
    "local:logs": "pnpm axi:logs"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
