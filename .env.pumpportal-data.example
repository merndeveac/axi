# AXI PumpPortal metered data setup
# Copy this file to .env.local and fill in only the public key and API key.
# DO NOT paste your PumpPortal private key here.
# DO NOT commit .env.local.
# This is for metered data streams only.
# It does not enable trading, signing, or transaction sending.

# Required: public wallet address linked to your PumpPortal API key.
PUMPPORTAL_DATA_WALLET_PUBLIC_KEY=

# Required: PumpPortal API key linked to the data wallet.
# Backend only. Never expose in frontend or commit.
PUMPPORTAL_DATA_API_KEY=

# Compatibility fallback for existing PumpPortal services.
# Leave blank for pnpm live:tokens:metered; it infers from PUMPPORTAL_DATA_API_KEY.
PUMPPORTAL_API_KEY=

# Optional but recommended for read-only balance checks.
SOLANA_RPC_HTTP=https://api.mainnet-beta.solana.com

# Live PumpPortal discovery.
AXI_RUNTIME_MODE=pumpportal_first
DATA_FEED_MODE=live
DATA_FEED=pumpportal
PUMPPORTAL_LIVE_DISCOVERY_ENABLED=true
PUMPPORTAL_SUBSCRIBE_NEW_TOKEN=true
PUMPPORTAL_SUBSCRIBE_MIGRATION=true

# Metered token-trade data for launch scanner.
METERED_LAUNCH_DATA_CONTROLS_ENABLED=true
METERED_LAUNCH_DATA_ENABLED=true
METERED_LAUNCH_DATA_START_ACTIVE=false
METERED_LAUNCH_DATA_REQUIRE_UI_ACK=true
METERED_LAUNCH_DATA_ACK_COST=false
METERED_LAUNCH_DATA_MODE=newest
METERED_LAUNCH_DATA_REQUIRE_DATA_WALLET_READY=true
METERED_LAUNCH_DATA_MAX_CONCURRENT_MINTS=3
METERED_LAUNCH_DATA_INITIAL_TRACK_MS=30000
METERED_LAUNCH_DATA_EXTENDED_TRACK_MS=300000
METERED_LAUNCH_DATA_MAX_EVENTS_PER_MINT=250
METERED_LAUNCH_DATA_MAX_EVENTS_PER_SESSION=1000
METERED_LAUNCH_DATA_MAX_SESSION_COST_SOL=0.001
METERED_LAUNCH_DATA_MAX_UI_SESSION_COST_SOL=0.005

# PumpPortal token trade gates.
PUMPPORTAL_TOKEN_TRADES_ENABLED=true
PUMPPORTAL_TOKEN_TRADES_ACK_METERED=false

# Hard safety settings.
PAPER_AUTO_ORDER=false
PUMPPORTAL_LIGHTNING_ALLOW_LIVE_TRADING=false
PUMPPORTAL_LIGHTNING_MANUAL_ARMED=false
EXIT_STRATEGY_ACCOUNT_TRADES_ENABLED=false
EXIT_STRATEGY_ACCOUNT_TRADES_ACK_METERED=false

# Explicitly disabled execution paths.
PUMPPORTAL_LIGHTNING_READINESS_ENABLED=true
PUMPPORTAL_USE_SAME_WALLET_FOR_DATA_AND_TRADING=false
