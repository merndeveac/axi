{
  "manifest_version": 3,
  "name": "AXI Local Overlay",
  "version": "0.1.0",
  "description": "Local paper-mode signal overlay skeleton.",
  "permissions": [],
  "host_permissions": ["http://localhost:8787/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
