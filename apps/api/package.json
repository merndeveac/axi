{
  "name": "@axi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "build": "tsc -b tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "replay": "tsx --conditions=development src/replay.ts",
    "chain:verify": "tsx --conditions=development src/chain-verify.ts",
    "chain:events:backfill": "tsx --conditions=development src/chain-events-backfill.ts",
    "chain:events:watch": "tsx --conditions=development src/chain-events-watch.ts",
    "market:decode": "tsx --conditions=development src/market-decode.ts",
    "feed:probe": "tsx --conditions=development src/feed-probe.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@axi/candidates": "workspace:*",
    "@axi/chain-events": "workspace:*",
    "@axi/data-feeds": "workspace:*",
    "@axi/execution": "workspace:*",
    "@axi/market-data": "workspace:*",
    "@axi/metrics": "workspace:*",
    "@axi/risk": "workspace:*",
    "@axi/scoring": "workspace:*",
    "@axi/shared": "workspace:*",
    "@axi/solana-chain": "workspace:*",
    "@axi/storage": "workspace:*",
    "fastify": "^5.0.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  }
}
