{
  "name": "@axi/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/main.ts",
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "smoke": "tsx --conditions=development src/main.ts smoke",
    "smoke:pumpfun": "tsx --conditions=development src/main.ts smoke:pumpfun",
    "smoke:managed-stream": "tsx --conditions=development src/main.ts smoke:managed-stream",
    "stream:status": "tsx --conditions=development src/main.ts stream:status",
    "stream:config": "tsx --conditions=development src/main.ts stream:config",
    "stream:build-subscription": "tsx --conditions=development src/main.ts stream:build-subscription",
    "decode:pumpfun": "tsx --conditions=development src/main.ts decode:pumpfun",
    "fetch:pumpfun-fixture": "tsx --conditions=development src/main.ts fetch:pumpfun-fixture",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@axi/event-bus": "workspace:*",
    "@axi/indexer-core": "workspace:*",
    "@axi/live-state": "workspace:*",
    "@axi/managed-stream-adapter": "workspace:*",
    "@axi/managed-stream-clients": "workspace:*",
    "@axi/pumpfun-decoder": "workspace:*",
    "@axi/stream-core": "workspace:*",
    "@axi/stream-mock": "workspace:*",
    "@axi/timeseries": "workspace:*",
    "zod": "^3.25.0"
  }
}
