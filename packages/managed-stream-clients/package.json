{
  "name": "@axi/managed-stream-clients",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./profiles": {
      "development": "./src/profiles.ts",
      "types": "./dist/profiles.d.ts",
      "import": "./dist/profiles.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@axi/stream-core": "workspace:*"
  }
}
